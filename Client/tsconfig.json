{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Vite compiles; tsc is only used for typechecking.
    "noEmit": true,

    // The API contract lives outside this package so the server can use the
    // same declarations. Type-only, so nothing is emitted or bundled.
    // No baseUrl: deprecated in TS 6. Under moduleResolution "bundler",
    // paths resolve relative to this file.
    "paths": {
      "@shared/*": ["../shared/*"]
    },

    "types": ["vite/client", "node"]
  },
  "include": ["src", "../shared", "vite.config.ts"]
}
